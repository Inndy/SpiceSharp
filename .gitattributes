# Text files are stored and checked out with LF line endings on every platform.
* text=auto eol=lf

# Windows batch files need CRLF to run correctly.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never convert or diff as text.
*.png binary
*.jpg binary
*.ico binary
*.spicerec binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
*.gz binary
*.cso binary
