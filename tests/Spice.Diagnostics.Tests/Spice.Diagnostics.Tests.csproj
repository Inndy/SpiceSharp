<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- Reflection probes run under the JIT; production retains its AOT settings. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/SpiceViewer/SpiceViewer.csproj" />
    <Compile Include="../../src/SpiceViewer/LogFile.cs" Link="Production/LogFile.cs" />
    <Compile Include="../Spice.Viewer.Tests/LogFileTests.cs" Link="LogFileTests.cs" />
    <!-- The status overlay's text, rates, blending and GDI image (docs/decisions/0044): no window, device or session. -->
    <Compile Include="../../src/SpiceViewer/StatusOverlay.cs" Link="Production/StatusOverlay.cs" />
    <Compile Include="../../src/SpiceViewer/OverlayBitmap.cs" Link="Production/OverlayBitmap.cs" />
    <Compile Include="../Shared/AllocationWindow.cs" Link="Shared/AllocationWindow.cs" />
    <AdditionalFiles Include="../../src/SpiceViewer/NativeMethods.json" />
  </ItemGroup>
</Project>
