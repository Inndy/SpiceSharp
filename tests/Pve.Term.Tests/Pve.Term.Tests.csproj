<Project Sdk="Microsoft.NET.Sdk">
  <!-- Window-free tests for the terminal bridge (docs/decisions/0036). The console test runs PveTerm under a
       pseudoconsole (no window); the fake termproxy server listens on loopback only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <StartupObject>Pve.Term.Tests.Probe</StartupObject>
    <!-- Pve.Term.Tests.exe runs the probe inside a pseudoconsole (Probe.cs). -->
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <Compile Include="../Shared/AllocationWindow.cs" Link="Shared/AllocationWindow.cs" />
    <ProjectReference Include="../../src/Pve.Term/Pve.Term.csproj" />
    <ProjectReference Include="../../src/PveTerm/PveTerm.csproj" />
  </ItemGroup>
</Project>
