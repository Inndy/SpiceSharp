<Project Sdk="Microsoft.NET.Sdk">
  <!-- Window-free tests for the PVE API client and the launcher's hand-offs (docs/decisions/0038, 0039). The fake PVE
       server listens on loopback only, with a certificate made per run; credential tests use their own target prefix
       and clean up. Run as a program, the assembly plays a fake viewer or terminal bridge (Helper.cs). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <StartupObject>Pve.Api.Tests.Helper</StartupObject>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <Compile Include="../Pve.Term.Tests/TestPki.cs" Link="Shared/TestPki.cs" />
    <ProjectReference Include="../../src/Pve.Api/Pve.Api.csproj" />
  </ItemGroup>
</Project>
