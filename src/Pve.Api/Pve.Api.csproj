<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Proxmox VE API client for the v1 launcher (docs/decisions/0038, 0039): sign-in (API token, or password with
       TFA), the VM list, spiceproxy to .vv text, starting the viewer and the terminal bridge, Credential Manager and
       the server list. No UI, so other front ends can reuse it. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Pve.Term/Pve.Term.csproj" />
    <ProjectReference Include="../VvFile/VvFile.csproj" />
    <InternalsVisibleTo Include="Pve.Api.Tests" />
  </ItemGroup>
</Project>
