<Project Sdk="Microsoft.NET.Sdk">
  <!-- PVE termproxy transport, the connection descriptor and its hand-off pipe (docs/decisions/0036).
       Shared by PveTerm.exe today and by the v1 launcher and a built-in VT later. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pve.Term.Tests" />
  </ItemGroup>
</Project>
