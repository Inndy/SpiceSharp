<Project Sdk="Microsoft.NET.Sdk">
  <!-- The v1 PVE launcher (docs/decisions/0038): a WinUI 3 window over Pve.Api. Unpackaged and self-contained
       (Windows App SDK included), so the portable zip needs no runtime install; Native AOT. It only does UI: the API,
       sign-in, credentials, settings and the viewer/terminal hand-offs live in src/Pve.Api. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>PveLauncher</RootNamespace>
    <AssemblyName>PveLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- A solution build ("Any CPU") still needs an architecture: the build machine's. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Not for an MSIX: this imports the tooling that publishes the app's resources.pri (compiled XAML), which plain
         .NET publish leaves out. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IlcInstructionSet Condition="'$(RuntimeIdentifier)' == 'win-x64'">x86-64-v3</IlcInstructionSet>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- The components of Windows App SDK 2.5.1 (2026-09-16), the newest release out at least two weeks, pinned to
         the versions that release names; only WinUI and what it needs (docs/decisions/0038). -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Pve.Api/Pve.Api.csproj" />
  </ItemGroup>
</Project>
