<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PveLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PveLauncher"
    Title="PVE Launcher">

    <Grid x:Name="Root" Padding="12" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Saved servers: no secrets here; a remembered secret is in Credential Manager. -->
        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Servers" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="ServerList" Grid.Row="1" ItemsSource="{x:Bind Servers}" SelectionMode="Single"
                      SelectionChanged="OnServerSelected" DoubleTapped="OnServerDoubleTapped">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ServerItem">
                        <StackPanel Padding="0,6">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="AddButton" Content="Add" Click="OnAddServer" />
                    <Button x:Name="EditButton" Content="Edit" Click="OnEditServer" IsEnabled="False" />
                    <Button x:Name="RemoveButton" Content="Remove" Click="OnRemoveServer" IsEnabled="False" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="SignOutButton" Content="Sign out" Click="OnSignOut" IsEnabled="False"
                            ToolTipService.ToolTip="Forget this server's session in memory" />
                    <Button x:Name="ForgetButton" Content="Forget saved…" Click="OnForget" IsEnabled="False"
                            ToolTipService.ToolTip="Delete the token secret or password saved in Windows Credential Manager" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Guests of the selected server. -->
        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- One line, trimmed (the subtitle style wraps by default); the version and account are smaller. -->
                <TextBlock x:Name="Heading" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <Run x:Name="HeadingName" Text="Guests" />
                    <Run x:Name="HeadingDetail" FontSize="14" FontWeight="Normal" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <TextBox x:Name="Filter" Grid.Column="1" VerticalAlignment="Center" PlaceholderText="Filter by name, VMID or node"
                         TextChanged="OnFilterChanged" />
                <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Click="OnRefresh" IsEnabled="False"
                        ToolTipService.ToolTip="Fetch the list again (F5)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" />

            <!-- Column header; widths match the item template. -->
            <Grid Grid.Row="2" Padding="12,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="VMID" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="1" Text="Name" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="2" Text="Node" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="3" Text="Type" Style="{StaticResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource CaptionTextBlockStyle}" />
            </Grid>

            <ListView x:Name="VmList" Grid.Row="3" ItemsSource="{x:Bind Guests}" SelectionMode="Single"
                      SelectionChanged="OnGuestSelected" DoubleTapped="OnGuestDoubleTapped" KeyDown="OnGuestKeyDown">
                <!-- The row's ContextRequested selects the row under the pointer before this opens. -->
                <ListView.ContextFlyout>
                    <MenuFlyout Opening="OnGuestMenuOpening">
                        <MenuFlyoutItem x:Name="MenuStart" Text="Start" Click="OnStart" />
                        <MenuFlyoutItem x:Name="MenuConsole" Text="Open console" Click="OnOpenConsole" />
                        <MenuFlyoutItem x:Name="MenuSpice" Text="Open SPICE console" Click="OnOpenSpice" />
                        <MenuFlyoutItem x:Name="MenuVnc" Text="Open VNC console" Click="OnOpenVnc" />
                        <MenuFlyoutItem x:Name="MenuTerminal" Text="Open terminal" Click="OnOpenTerminal" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:GuestItem">
                        <!-- Transparent, so a right-click between the columns still hits the row. -->
                        <Grid ColumnSpacing="8" Opacity="{x:Bind Opacity}" Background="Transparent"
                              ContextRequested="OnGuestRowContextRequested">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Vmid}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Node}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Type}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Status}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ConsoleButton" Content="Open console" Style="{StaticResource AccentButtonStyle}"
                        Click="OnOpenConsole" IsEnabled="False"
                        ToolTipService.ToolTip="VM with SPICE: SpiceViewer. VM without: VNC in your VNC viewer. Container: terminal. (Enter or double-click)" />
                <Button x:Name="VncButton" Grid.Column="1" Content="Open VNC console" Click="OnOpenVnc" IsEnabled="False"
                        ToolTipService.ToolTip="VM: its VNC display in your own VNC viewer, through PveTerm's VNC bridge." />
                <Button x:Name="TerminalButton" Grid.Column="2" Content="Open terminal" Click="OnOpenTerminal" IsEnabled="False"
                        ToolTipService.ToolTip="VM: serial console. Container: console. Opens in your terminal through PveTerm." />
                <!-- Shown only for a stopped guest the account may start (VM.PowerMgmt, when the server says). -->
                <Button x:Name="StartButton" Grid.Column="3" Content="Start" Click="OnStart" Visibility="Collapsed"
                        ToolTipService.ToolTip="Start this stopped guest, as the web UI's Start does" />
                <TextBlock Grid.Column="5" Text="VNC viewer:" VerticalAlignment="Center" />
                <!-- Items in the order of MainWindow.VncChoices; labelled from the detection when the list opens. -->
                <ComboBox x:Name="VncChoice" Grid.Column="6" SelectionChanged="OnVncChoiceChanged"
                          DropDownOpened="OnVncChoiceOpened" MinWidth="180">
                    <ComboBoxItem x:Name="AutoVncItem" Content="Automatic" />
                    <ComboBoxItem x:Name="TigerVncItem" Content="TigerVNC" />
                    <ComboBoxItem x:Name="UltraVncItem" Content="UltraVNC" />
                    <ComboBoxItem x:Name="TightVncItem" Content="TightVNC" />
                    <ComboBoxItem x:Name="RealVncItem" Content="RealVNC Viewer" />
                    <ComboBoxItem Content="None (connect one yourself)" />
                    <ComboBoxItem x:Name="CustomVncItem" Content="Custom command (launcher.json)" />
                </ComboBox>
                <TextBlock Grid.Column="7" Text="Terminal:" VerticalAlignment="Center" />
                <!-- Items in the order of MainWindow.TerminalChoices. The Windows Terminal items are labelled from the
                     detection and shown only when found (or chosen). -->
                <ComboBox x:Name="TerminalChoice" Grid.Column="8" SelectionChanged="OnTerminalChoiceChanged"
                          DropDownOpened="OnTerminalChoiceOpened" DropDownClosed="OnTerminalChoiceClosed" MinWidth="200">
                    <ComboBoxItem x:Name="AutoTerminalItem" Content="Automatic" />
                    <ComboBoxItem x:Name="WtTerminalItem" Content="Windows Terminal" />
                    <ComboBoxItem x:Name="WtPreviewTerminalItem" Content="Windows Terminal Preview" />
                    <ComboBoxItem x:Name="MinttyTerminalItem" Content="mintty" />
                    <ComboBoxItem Content="Default terminal app (new console)" />
                    <ComboBoxItem Content="Console host (conhost)" />
                    <ComboBoxItem x:Name="CustomTerminalItem" Content="Custom command (launcher.json)" />
                </ComboBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
